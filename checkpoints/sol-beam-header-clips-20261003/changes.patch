+public class BeamHeaderPixelsProbe extends BeamsProbe {
+ public BeamHeaderPixelsProbe(Book b,SortedSet<Integer>ids){super(b,ids);}
+ public void process(){try{
+  Object sheet=call(((List<?>)call(book,"getStubs")).get(0),"getSheet");call(cls("org.audiveris.omr.sheet.grid.GridStep").getConstructor().newInstance(),"doit",sheet);
+  for(Object sys:(List<?>)call(sheet,"getSystems"))call(construct("org.audiveris.omr.sheet.header.HeaderBuilder",new Class<?>[]{cls("org.audiveris.omr.sheet.SystemInfo")},sys),"processHeader");
+  call(cls("org.audiveris.omr.sheet.stem.StemSeedsStep").getConstructor().newInstance(),"doit",sheet);
+  Object picture=call(sheet,"getPicture"),image=call(picture,"getSource",enumValue("org.audiveris.omr.sheet.Picture$SourceKey","NO_STAFF"));Object builder=construct("org.audiveris.omr.sheet.beam.SpotsBuilder",new Class<?>[]{cls("org.audiveris.omr.sheet.Sheet")},sheet);Object buffer=call(builder,"getBuffer");String before=mask(buffer);call(builder,"eraseHeaderAreas",buffer);
+  Files.writeString(Path.of(System.getProperty("native.probe.output")),"{\"native_outputs_used\":false,\"scope\":\"Actual original GRID/live HEADERS/STEM_SEEDS then SpotsBuilder Gaussian buffer and eraseHeaderAreas; no downstream beam/rest claim\",\"header_erase_rectangles\":"+headerEraseRectangles(sheet)+",\"no_staff\":"+mask(image)+",\"gaussian\":"+before+",\"header_erased\":"+mask(buffer)+"}\n");
+ }catch(Exception e){throw new RuntimeException(e);}}
+}
