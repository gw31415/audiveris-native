+#[test]
+fn original_clef_neighbor_browse_rectangle_controls_match() {
+    let f: Value = serde_json::from_str(include_str!(
+        "../fixtures/official-clef-neighbor-rects.json"
+    ))
+    .unwrap();
+    assert_eq!(f["native_outputs_used"], false);
