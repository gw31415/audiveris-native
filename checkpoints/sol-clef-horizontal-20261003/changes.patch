+                &input["grid"],
+                &h,
+                input["height"].as_u64().unwrap() as usize,
+                11,
+            )
+            .unwrap();
+            let row = rows
+                .iter()
+                .find(|s| s["staff_id"] == q["staff_id"])
+                .unwrap();
+            assert_eq!(row["outer"], q["outer"], "{} {q}", c["name"]);
+            assert_eq!(row["inner"], q["inner"]);
+        }
+    }
+    let c = &f["configurations"][0];
